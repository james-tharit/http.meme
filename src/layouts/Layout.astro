---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "HTTP MEME | Status codes, explained badly",
	description = "Every HTTP status code, matched to the meme it actually is.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="site-column">
			<header>
				<h1><a href="/">HTTP<span>.MEME</span></a></h1>
				<p class="tagline">Status codes, explained badly.</p>
			</header>

			<main>
				<slot />
			</main>

			<footer>
				<p>
					&copy; {new Date().getFullYear()} http.meme &middot; For entertainment
					only. Do not cite this in an RFC.
				</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0d0d12;
		--surface: #17171f;
		--border: #2a2a36;
		--primary: #b4ff39;
		--text: #ffffff;
		--text-dim: #9a9aae;
		--max-width: 1400px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background-color: var(--bg);
		color: var(--text);
		font-family: "Space Grotesk", system-ui, sans-serif;
	}

	.site-column {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 100vh;
		width: 100%;
	}

	header {
		width: 100%;
		max-width: var(--max-width);
		padding: 3rem 1rem 1rem;
	}

	header h1 {
		margin: 0;
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 700;
		letter-spacing: -2px;
	}

	header h1 a {
		color: var(--text);
		text-decoration: none;
	}

	header h1 span {
		color: var(--primary);
	}

	.tagline {
		color: var(--text-dim);
		font-size: 1.1rem;
		margin: 0.75rem 0 0;
	}

	main {
		width: 100%;
		max-width: var(--max-width);
		padding: 1rem;
		flex-grow: 1;
	}

	footer {
		width: 100%;
		max-width: var(--max-width);
		padding: 2rem 1rem;
		border-top: 1px solid var(--border);
		color: var(--text-dim);
		font-size: 0.85rem;
	}

	a:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 3px;
	}
</style>
