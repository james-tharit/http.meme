---
import Layout from "../../layouts/Layout.astro";
import CodeImage from "../../components/CodeImage.astro";
import { statusCodes } from "../../data/status";

export function getStaticPaths() {
    return statusCodes.map((status) => ({
        params: { code: status.code.toString() },
        props: { status },
    }));
}

const { status } = Astro.props;
---

<Layout
    title={`${status.code} ${status.title} | http.meme`}
    description={`${status.code} ${status.title} — ${status.memeName}. ${status.desc}`}
>
    <article class="status">
        <header class="status-header">
            <span class="status-num">{status.code}</span>
            <h2>{status.title}</h2>
        </header>

        <div class="image-wrapper">
            <CodeImage code={status.code} title={status.title} eager />
        </div>

        <div class="box">
            <span class="badge">AKA</span>
            <h3 class="meme-name">{status.memeName}</h3>
            <p class="desc">{status.desc}</p>
        </div>

        <div class="box spec">
            <h3>What it actually means</h3>
            <p>{status.usage}</p>
            {
                status.source && (
                    <p class="source">
                        <a href={status.source} rel="noopener noreferrer">
                            Meme origin &rarr;
                        </a>
                    </p>
                )
            }
        </div>

        <a href="/" class="back">&larr; All status codes</a>
    </article>
</Layout>

<style>
    .status {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        padding-top: 2rem;
    }

    .status-header {
        border-bottom: 2px solid var(--primary);
        width: 100%;
        padding-bottom: 1rem;
    }

    .status-num {
        font-size: 5rem;
        font-weight: 700;
        line-height: 1;
        color: var(--primary);
    }

    .status-header h2 {
        font-size: 2rem;
        margin: 0;
        text-transform: uppercase;
    }

    .image-wrapper {
        width: 100%;
        max-width: 750px;
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
    }

    .box {
        background: var(--surface);
        padding: 2rem;
        border-left: 5px solid var(--primary);
        width: 100%;
        max-width: 750px;
    }

    .badge {
        background: var(--primary);
        color: var(--bg);
        padding: 2px 8px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .meme-name {
        font-size: 2.5rem;
        margin: 0.75rem 0 1rem;
    }

    .desc {
        font-size: 1.25rem;
        margin: 0;
    }

    .spec {
        border-left-color: var(--border);
    }

    .spec h3 {
        margin-top: 0;
        color: var(--text-dim);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .spec p {
        margin: 0;
    }

    .source {
        margin-top: 1rem !important;
    }

    .source a,
    .back {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
    }

    .source a:hover,
    .back:hover {
        text-decoration: underline;
    }

    .back {
        color: var(--text-dim);
    }
</style>
